<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; margin: 0; padding: 20px; background: #f5f5f5; color: #333; }
  .container { max-width: 600px; margin: 0 auto; background: #fff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); overflow: hidden; }
  .header { background: #1a1a2e; color: #fff; padding: 20px 24px 16px; }
  .header h1 { margin: 0; font-size: 18px; font-weight: 600; }
  .header .sub { color: #a0a0c0; font-size: 12px; margin-top: 2px; }

  {# ── Hero P&L ── #}
  .hero { padding: 20px 24px; text-align: center; border-bottom: 1px solid #eee; }
  .hero-pnl { font-size: 36px; font-weight: 700; letter-spacing: -0.5px; }
  .hero-pnl.up { color: #16a34a; }
  .hero-pnl.down { color: #dc2626; }
  .hero-pnl.flat { color: #666; }
  .hero-meta { display: flex; justify-content: center; gap: 20px; margin-top: 8px; font-size: 13px; color: #666; }
  .hero-meta strong { color: #333; }

  {# ── Sections ── #}
  .section { padding: 16px 24px; border-bottom: 1px solid #eee; }
  .section:last-child { border-bottom: none; }
  .section h2 { font-size: 13px; color: #888; margin: 0 0 10px 0; text-transform: uppercase; letter-spacing: 0.8px; font-weight: 600; }

  {# ── Tables ── #}
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { text-align: left; padding: 5px 6px; color: #888; font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #eee; }
  td { padding: 5px 6px; border-bottom: 1px solid #f5f5f5; }
  .r { text-align: right; font-variant-numeric: tabular-nums; }
  .green { color: #16a34a; }
  .red { color: #dc2626; }
  .muted { color: #999; }
  .bold { font-weight: 600; }

  {# ── Highlights ── #}
  .hl-row { display: flex; justify-content: space-between; padding: 3px 0; font-size: 13px; }
  .hl-label { color: #666; }
  .hl-value { font-weight: 600; }

  {# ── Alert box ── #}
  .alert { background: #fef3c7; border-left: 3px solid #f59e0b; padding: 10px 14px; margin: 8px 0; font-size: 13px; border-radius: 0 4px 4px 0; }
  .alert.danger { background: #fef2f2; border-color: #dc2626; }

  {# ── Comparison ── #}
  .comp-box { background: #f8f9fa; border-radius: 6px; padding: 14px; margin-top: 6px; }
  .comp-rate { font-size: 24px; font-weight: 700; text-align: center; }
  .comp-grid { display: flex; justify-content: space-around; margin-top: 10px; text-align: center; font-size: 12px; }
  .comp-grid .val { font-weight: 600; font-size: 16px; }
  .badge { display: inline-block; padding: 1px 7px; border-radius: 10px; font-size: 11px; font-weight: 500; }
  .badge-v1 { background: #dbeafe; color: #1d4ed8; }
  .badge-v2 { background: #dcfce7; color: #16a34a; }

  {# ── Side badges ── #}
  .side-buy { color: #16a34a; font-weight: 600; }
  .side-sell { color: #dc2626; font-weight: 600; }

  .footer { padding: 12px 24px; text-align: center; color: #bbb; font-size: 11px; }
</style>
</head>
<body>
<div class="container">

  {# ── Header ── #}
  <div class="header">
    <h1>BotTrader v2 &mdash; {% if data.period_hours >= 24 %}Daily Report{% else %}{{ data.period_hours }}h Report{% endif %}</h1>
    <div class="sub">{{ data.report_date }}{% if data.period_start and data.period_hours < 24 %} {{ data.period_start.strftime('%H:%M') }}&ndash;{{ data.period_end.strftime('%H:%M') }} UTC{% endif %} &middot; {{ data.period_hours }}h window</div>
  </div>

  {# ════════════════════════════════════════════════════════════
     1. HOW DID I DO?  — The headline
     ════════════════════════════════════════════════════════════ #}
  <div class="hero">
    {% set pnl_class = 'up' if data.pnl.net_pnl > 0 else ('down' if data.pnl.net_pnl < 0 else 'flat') %}
    <div class="hero-pnl {{ pnl_class }}">{{ data.pnl.net_pnl | money }}</div>
    <div class="hero-meta">
      <span><strong>{{ data.pnl.win_count }}W</strong> / {{ data.pnl.loss_count }}L ({{ data.pnl.win_rate | pct }})</span>
      <span>{{ data.trade_stats.buy_count + data.trade_stats.sell_count }} fills</span>
      <span>{{ data.trade_stats.total_fees | money }} fees</span>
    </div>
    {% if data.pnl.best_trade or data.pnl.worst_trade %}
    <div class="hero-meta" style="margin-top: 4px;">
      {% if data.pnl.best_trade %}
      <span class="green">Best: {{ data.pnl.best_trade[0] }} {{ data.pnl.best_trade[1] | money }}</span>
      {% endif %}
      {% if data.pnl.worst_trade %}
      <span class="red">Worst: {{ data.pnl.worst_trade[0] }} {{ data.pnl.worst_trade[1] | money }}</span>
      {% endif %}
    </div>
    {% endif %}
  </div>

  {# ════════════════════════════════════════════════════════════
     1.5. PORTFOLIO VALUE  — Starting/ending balance, watermarks
     ════════════════════════════════════════════════════════════ #}
  {% if data.portfolio %}
  <div class="section">
    <h2>Portfolio</h2>
    {% set port_pnl = data.portfolio.ending_value - data.portfolio.starting_value %}
    <div class="hl-row">
      <span class="hl-label">Starting</span>
      <span class="hl-value">{{ data.portfolio.starting_value | money }}</span>
    </div>
    <div class="hl-row">
      <span class="hl-label">Ending</span>
      <span class="hl-value {% if port_pnl > 0 %}green{% elif port_pnl < 0 %}red{% endif %}">{{ data.portfolio.ending_value | money }}</span>
    </div>
    <div class="hl-row">
      <span class="hl-label">High / Low</span>
      <span class="hl-value">{{ data.portfolio.high_watermark | money }} / {{ data.portfolio.low_watermark | money }}</span>
    </div>
    {% if data.portfolio.high_watermark > 0 %}
    {% set drawdown = (data.portfolio.high_watermark - data.portfolio.low_watermark) / data.portfolio.high_watermark %}
    <div class="hl-row">
      <span class="hl-label">Max drawdown</span>
      <span class="hl-value {% if drawdown > 0.02 %}red{% endif %}">{{ drawdown | pct }}</span>
    </div>
    {% endif %}
    <div class="hl-row">
      <span class="hl-label">Cash / Positions</span>
      <span class="hl-value">{{ data.portfolio.cash_balance | money }} / {{ data.portfolio.positions_value | money }}</span>
    </div>
  </div>
  {% endif %}

  {# ════════════════════════════════════════════════════════════
     2. P&L BY SYMBOL  — Where did money come from / go
     ════════════════════════════════════════════════════════════ #}
  {% if data.pnl.by_symbol %}
  <div class="section">
    <h2>P&amp;L by Symbol</h2>
    <table>
      <tr><th>Symbol</th><th class="r">Trades</th><th class="r">P&amp;L</th></tr>
      {% for sym, pnl in data.pnl.by_symbol.items() | sort(attribute='1', reverse=true) %}
      <tr>
        <td>{{ sym }}</td>
        <td class="r muted">
          {%- if data.pnl.fills_by_symbol.get(sym) -%}
            {{ data.pnl.fills_by_symbol[sym].get('BUY', 0) }}B / {{ data.pnl.fills_by_symbol[sym].get('SELL', 0) }}S
          {%- else -%}
            —
          {%- endif -%}
        </td>
        <td class="r bold {% if pnl > 0 %}green{% elif pnl < 0 %}red{% endif %}">{{ pnl | money }}</td>
      </tr>
      {% endfor %}
    </table>
  </div>
  {% endif %}

  {# ════════════════════════════════════════════════════════════
     2.5. TRADE LOG  — Every individual fill
     ════════════════════════════════════════════════════════════ #}
  {% if data.trade_log %}
  <div class="section">
    <h2>Trade Log</h2>
    <table>
      <tr><th>Time</th><th>Symbol</th><th>Side</th><th class="r">Price</th><th class="r">Notional</th><th class="r">P&amp;L</th></tr>
      {% for t in data.trade_log %}
      <tr>
        <td class="muted">{{ t.timestamp.strftime('%H:%M:%S') }}</td>
        <td>{{ t.symbol }}</td>
        <td class="{% if t.side == 'BUY' %}side-buy{% else %}side-sell{% endif %}">{{ t.side }}</td>
        <td class="r">{{ "%.4f" | format(t.price) }}</td>
        <td class="r">{{ t.notional | money }}</td>
        <td class="r {% if t.realized_pnl is not none and t.realized_pnl > 0 %}green{% elif t.realized_pnl is not none and t.realized_pnl < 0 %}red{% endif %}">
          {{ t.realized_pnl | money if t.realized_pnl is not none else '—' }}
        </td>
      </tr>
      {% endfor %}
    </table>
  </div>
  {% endif %}

  {# ════════════════════════════════════════════════════════════
     3. OPEN POSITIONS  — What am I holding
     ════════════════════════════════════════════════════════════ #}
  {% if data.positions %}
  <div class="section">
    <h2>Open Positions</h2>
    <table>
      <tr><th>Symbol</th><th class="r">Qty</th><th class="r">Avg Entry</th><th class="r">Cost</th><th class="r">Unrealized</th></tr>
      {% for pos in data.positions %}
      <tr>
        <td>{{ pos.symbol }}</td>
        <td class="r">{{ "%.6f" | format(pos.qty) }}</td>
        <td class="r">{{ "%.4f" | format(pos.avg_entry) }}</td>
        <td class="r">{{ pos.cost_basis | money }}</td>
        <td class="r {% if pos.unrealized_pnl and pos.unrealized_pnl > 0 %}green{% elif pos.unrealized_pnl and pos.unrealized_pnl < 0 %}red{% endif %}">
          {{ pos.unrealized_pnl | money if pos.unrealized_pnl is not none else '—' }}
        </td>
      </tr>
      {% endfor %}
    </table>
  </div>
  {% endif %}

  {# ════════════════════════════════════════════════════════════
     3.5. EXIT MANAGER  — Stop/trail activity
     ════════════════════════════════════════════════════════════ #}
  {% if data.exit_manager %}
  <div class="section">
    <h2>Exit Manager</h2>
    <div class="hl-row">
      <span class="hl-label">Hard stops</span>
      <span class="hl-value {% if data.exit_manager.hard_stops %}red{% endif %}">{{ data.exit_manager.hard_stops }}</span>
    </div>
    <div class="hl-row">
      <span class="hl-label">Soft stops</span>
      <span class="hl-value {% if data.exit_manager.soft_stops %}red{% endif %}">{{ data.exit_manager.soft_stops }}</span>
    </div>
    <div class="hl-row">
      <span class="hl-label">Trailing stops</span>
      <span class="hl-value">{{ data.exit_manager.trailing_stops }}</span>
    </div>
    {% if data.exit_manager.trailing_activations %}
    <div class="hl-row">
      <span class="hl-label">Trailing activations</span>
      <span class="hl-value green">{{ data.exit_manager.trailing_activations }}</span>
    </div>
    {% endif %}
    {% if data.exit_manager.events %}
    <table style="margin-top: 8px;">
      <tr><th>Time</th><th>Symbol</th><th>Type</th><th class="r">Price</th><th class="r">P&amp;L%</th></tr>
      {% for evt in data.exit_manager.events %}
      <tr>
        <td class="muted">{{ evt.timestamp.strftime('%H:%M') }}</td>
        <td>{{ evt.symbol }}</td>
        <td>{{ evt.reason }}</td>
        <td class="r">{{ "%.4f" | format(evt.price) }}</td>
        <td class="r {% if evt.pnl_pct > 0 %}green{% else %}red{% endif %}">{{ "%.2f" | format(evt.pnl_pct) }}%</td>
      </tr>
      {% endfor %}
    </table>
    {% endif %}
  </div>
  {% endif %}

  {# ════════════════════════════════════════════════════════════
     4. SYSTEM HEALTH  — Is the bot working correctly
     ════════════════════════════════════════════════════════════ #}
  <div class="section">
    <h2>System Health</h2>
    <div class="hl-row">
      <span class="hl-label">Signals generated</span>
      <span class="hl-value">{{ data.signals.total }} ({{ data.signals.buy_count }}B / {{ data.signals.sell_count }}S)</span>
    </div>
    <div class="hl-row">
      <span class="hl-label">Symbols active</span>
      <span class="hl-value">{{ data.signals.by_symbol | length if data.signals.by_symbol else data.trade_stats.symbols_traded | length }}</span>
    </div>
    {% if data.risk.vetoes or data.risk.circuit_breaker_trips or data.risk.rejections %}
    <div class="alert{% if data.risk.circuit_breaker_trips %} danger{% endif %}" style="margin-top: 8px;">
      {% if data.risk.vetoes %}<div>{{ data.risk.vetoes }} signal{{ 's' if data.risk.vetoes != 1 }} vetoed by risk manager</div>{% endif %}
      {% if data.risk.circuit_breaker_trips %}<div>{{ data.risk.circuit_breaker_trips }} circuit breaker trip{{ 's' if data.risk.circuit_breaker_trips != 1 }}</div>{% endif %}
      {% if data.risk.rejections %}<div>{{ data.risk.rejections }} order{{ 's' if data.risk.rejections != 1 }} rejected</div>{% endif %}
    </div>
    {% if data.risk.events %}
    <div style="margin-top: 6px; font-size: 12px; color: #888;">
      {% for evt in data.risk.events[:5] %}<div>{{ evt }}</div>{% endfor %}
      {% if data.risk.events | length > 5 %}<div class="muted">... and {{ data.risk.events | length - 5 }} more</div>{% endif %}
    </div>
    {% endif %}
    {% else %}
    <div style="margin-top: 4px; font-size: 12px; color: #999;">No risk events.</div>
    {% endif %}
  </div>

  {# ════════════════════════════════════════════════════════════
     5. v1 vs v2 COMPARISON  — Transition monitoring
     ════════════════════════════════════════════════════════════ #}
  {% if data.comparison and (data.comparison.v1_signal_count or data.comparison.v2_signal_count) %}
  <div class="section">
    <h2>v1 vs v2 Comparison</h2>
    <div class="comp-box">
      <div class="muted" style="text-align: center; font-size: 11px; margin-bottom: 2px;">Signal Agreement</div>
      <div class="comp-rate {% if data.comparison.agreement_rate >= 0.8 %}green{% elif data.comparison.agreement_rate < 0.5 %}red{% endif %}">
        {{ data.comparison.agreement_rate | pct }}
      </div>
      <div class="comp-grid">
        <div><div class="val">{{ data.comparison.v1_signal_count }}</div><div class="muted">v1</div></div>
        <div><div class="val">{{ data.comparison.v2_signal_count }}</div><div class="muted">v2</div></div>
        <div><div class="val">{{ data.comparison.agreement_count }}</div><div class="muted">matched</div></div>
      </div>
    </div>
    {% if data.comparison.symbols_only_v1 or data.comparison.symbols_only_v2 %}
    <div style="margin-top: 10px; font-size: 12px;">
      {% if data.comparison.symbols_only_v1 %}
      <div style="margin-bottom: 3px;"><span class="muted">v1 only:</span> {% for s in data.comparison.symbols_only_v1 | sort %}<span class="badge badge-v1">{{ s }}</span> {% endfor %}</div>
      {% endif %}
      {% if data.comparison.symbols_only_v2 %}
      <div><span class="muted">v2 only:</span> {% for s in data.comparison.symbols_only_v2 | sort %}<span class="badge badge-v2">{{ s }}</span> {% endfor %}</div>
      {% endif %}
    </div>
    {% endif %}
  </div>
  {% endif %}

  {# ── Footer ── #}
  <div class="footer">
    BotTrader v2 &middot; {{ data.generated_at.strftime('%H:%M UTC') if data.generated_at else '' }}
  </div>

</div>
</body>
</html>
