# === BotTrader .gitignore (union) ===
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
.venv/
venv/
.env
.env.*
.envrc

# OS / Editors
.DS_Store
.idea/
.vscode/
*.swp

# Tests / Build
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/

# Docker
docker-data/
**/.dockerignore.tmp

# Logs (IMPORTANT)
logs/
logs/**
shared_logger.log
sighook_logger.log
webhook_logger.log

# Local overrides (optional)
docker-compose.override.yml
# === end ===

# env & local artifacts
project file tree
.env_tradebot
env_*
*.pkg
recent_orders.json
Trade records for review

# API key files
kraken_api_info.json
Config/websocket_api_info.json
Config/*_api_info.json
Config/*.key
Config/*.pem
# Any Coinbase/exchange key file, anywhere in the tree (2026-09-17)
**/*api_key*.json
**/*_key.json
**/cdp_api_key*.json
**/*.pem

# One-off debug scripts with hardcoded credentials (do not re-track)
.claude/testing/test_peak_tracking_edge.py

# rotation backtest cache/output (local data, not checked in)
backtest/rotation/cache/
backtest/rotation/output/*
!backtest/rotation/output/.gitkeep
# Claude Code: .claude/settings.json IS committed (shared project permission rules).
# settings.local.json is per-machine and must stay out of git.
.claude/settings.local.json

# Stray virtualenv copies — .venv/ above matches that exact name only, so a
# renamed copy like .venv.old/ would otherwise be committable.
.venv*/
