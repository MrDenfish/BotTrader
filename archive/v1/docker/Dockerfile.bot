# ------------------------------------------------------------------------------
# Dockerfile.bot
# ------------------------------------------------------------------------------
#
# Purpose:
#   Build the runtime container for the trading bot itself.
#
# What it does:
#   - Uses python:3.11-slim as base
#   - Installs build tools, tini, and SSL certificates
#   - Creates a non-root user (appuser)
#   - Installs Python dependencies from requirements.txt
#   - Copies the entire application codebase into /app
#   - Removes any stray .env files to avoid leaking dev configs
#   - Runs as non-root user
#   - Starts via tini with entrypoint-bot
#
# ------------------------------------------------------------------------------

FROM python:3.11-slim

# add bash (entrypoint uses bash), tini for signal handling
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates curl tini build-essential \
 && rm -rf /var/lib/apt/lists/*

# non-root user
RUN useradd -ms /bin/bash appuser
WORKDIR /app

# Install Python deps first (cached unless requirements.txt changes)
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy source (changes here don't invalidate pip cache)
COPY . /app
# Remove any legacy env files from old multi-env system
RUN rm -f /app/.env_tradebot /app/.env_tradebot_sensitive || true
# Fix scripts directory permissions (ensure cron jobs can execute)
RUN chmod -R 755 /app/scripts || true

# ensure entrypoint has LF endings and is executable
RUN sed -i 's/\r$//' /app/docker/entrypoint/entrypoint.bot.sh \
 && chmod +x /app/docker/entrypoint/entrypoint.bot.sh

ENV TZ=UTC
USER appuser

ENTRYPOINT ["/usr/bin/tini","--","/app/docker/entrypoint/entrypoint.bot.sh"]
